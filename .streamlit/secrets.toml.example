# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > App settings > Secrets.
# Optional: without a key the app uses the deterministic template writer.
OPENAI_API_KEY = "voc-..."                              # Vocareum key (or an OpenAI sk-... key)
OPENAI_API_BASE = "https://openai.vocareum.com/v1"      # omit for api.openai.com
