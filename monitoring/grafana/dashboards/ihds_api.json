{
  "uid": "ihds-api",
  "title": "IHDS API (FastAPI /metrics)",
  "tags": [
    "ihds"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Assessments (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum(ihds_assess_total) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Escalations (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum(ihds_escalations_total) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "High-risk predictions (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum(ihds_predictions_total{band=\"high\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocked by safety guard (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum(ihds_assess_total{status=\"blocked\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum by (route, status) (rate(ihds_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request latency p50 / p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(ihds_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ihds_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Predictions by risk band (per 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum by (band) (increase(ihds_predictions_total[5m]))",
          "legendFormat": "{{band}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Escalations and outcomes (per 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "ihds-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum(increase(ihds_escalations_total[5m]))",
          "legendFormat": "escalated"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ihds-prometheus"
          },
          "expr": "sum by (status, draft_source) (increase(ihds_assess_total[5m]))",
          "legendFormat": "{{status}} / {{draft_source}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
