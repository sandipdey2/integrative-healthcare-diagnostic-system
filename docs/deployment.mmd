flowchart LR
  UI["Streamlit app.py<br/>:8501"]
  subgraph API["FastAPI api/main.py :8000"]
    R0["GET /assessments/recent"]
    R1["GET /health"]
    R2["GET /metrics"]
    R3["GET /monitoring/summary"]
    R4["GET /schema/features"]
    R5["POST /assess"]
  end
  subgraph G["LangGraph StateGraph (ihds/agents.py)"]
    evidence_agent["evidence_agent"]
    risk_agent["risk_agent"]
    uncertainty_agent["uncertainty_agent"]
  end
  subgraph MCP["MCP server mcp_server/server.py (mcp-stdio here; streamable HTTP :8765 in Docker)"]
    T_explain_contributions["explain_contributions"]
    T_population_context["population_context"]
    T_rag_search["rag_search"]
    T_risk_score["risk_score"]
    T_synthetic_neighbors["synthetic_neighbors"]
  end
  UI -- "IHDS_API_URL (Docker/Azure) or embedded on 127.0.0.1 (ihds/embedded_api.py)" --> API
  UI -. "fallback: in-process" .-> G
  API --> G
  evidence_agent -- MCP --> T_population_context
  evidence_agent -- MCP --> T_rag_search
  risk_agent -- MCP --> T_explain_contributions
  risk_agent -- MCP --> T_risk_score
  uncertainty_agent -- MCP --> T_synthetic_neighbors
  subgraph EXT["Optional services (on only when configured)"]
    LLM["gpt-4o-mini writer (OPENAI_API_KEY; template otherwise)"]
    DB[("Audit log: Postgres/Neon (DATABASE_URL) or SQLite")]
    LS["LangSmith traces (LANGSMITH_API_KEY)"]
    GR["Grafana Cloud remote write (GRAFANA_RW_*) / Prometheus scrape (Docker)"]
  end
  CH[("ChromaDB in-memory index, ONNX MiniLM (TF-IDF fallback)")]
  T_rag_search --> CH
  G -- writer_agent --> LLM
  API -- "POST /assess row" --> DB
  G -. "ihds-assessment run + writer_llm child" .-> LS
  API -. "ihds_* metrics" .-> GR
