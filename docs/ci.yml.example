# GitHub Actions CI/CD for IHDS.
# To enable: on github.com open the repo -> Add file -> Create new file, name it .github/workflows/ci.yml,
# paste this file's contents and commit to main (see docs/MLOPS.md, "Turning on GitHub Actions").
# It is kept here as an example because the token used to push this repo has no `workflow` scope.
#
# Jobs: lint (ruff) -> test (52 offline pytest tests + /metrics test) and data-validation + mlops tests
# (Great Expectations gate, MLflow / Deepchecks / SHAP / Fairlearn / Feast / Prefect tests, `dvc repro`)
# -> docker (build the app image and smoke-test /health and /metrics) and monitoring-stack (Prometheus +
# Grafana on a plain bridge network) -> deploy (optional, manual only).
name: ci-cd

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      deploy:
        description: "Run the optional Azure Container Apps deploy job"
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install ruff==0.17.6
      - run: ruff check .

  test:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: pip install -r requirements-dev.txt
      # The 4 live `vocareum` tests skip because no OPENAI_API_KEY is set; MLOps tests skip (tools not installed).
      - run: pytest -q

  data-validation:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: pip install -r requirements-mlops.txt
      - name: Great Expectations gate (fails the job if any expectation fails)
        run: python -m ihds.mlops.validate
      - name: MLOps tests (MLflow, Deepchecks, SHAP, Fairlearn, Feast, Prefect, configs)
        run: pytest -q tests/test_mlops.py
      - name: DVC pipeline (local cache only, no remote)
        run: dvc repro
      - uses: actions/upload-artifact@v4
        with:
          name: mlops-reports
          path: |
            reports/*.json
            reports/shap_summary.png
            reports/deepchecks/*.html

  docker:
    needs: [test, data-validation]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: docker build
        run: docker build -t ihds:${{ github.sha }} .
      - name: Smoke test (FastAPI /health and /metrics inside the image)
        run: |
          docker run -d --name ihds-api -p 8000:8000 ihds:${{ github.sha }} \
            uvicorn api.main:app --host 0.0.0.0 --port 8000
          for i in $(seq 1 60); do curl -fsS http://127.0.0.1:8000/health && break; sleep 3; done
          curl -fsS http://127.0.0.1:8000/metrics | grep ihds_http_requests_total
          docker rm -f ihds-api

  # Brings up docker-compose.monitoring.yml unmodified (plain bridge network) and checks that Prometheus
  # scrapes the API by service name and that Grafana has the provisioned datasource and dashboard with data.
  monitoring-stack:
    needs: [test]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate configs
        run: |
          docker compose -f docker-compose.monitoring.yml config -q
          docker run --rm -v "$PWD/monitoring/prometheus:/cfg:ro" --entrypoint promtool prom/prometheus:v3.5.0 \
            check config /cfg/prometheus.yml
      - name: Start the stack
        run: docker compose -f docker-compose.monitoring.yml up -d --build --wait --wait-timeout 600
      - name: Generate traffic and check Prometheus + Grafana
        run: |
          for i in $(seq 1 20); do
            curl -fsS -X POST localhost:8000/assess -H 'content-type: application/json' \
              -d '{"record":{"Pregnancies":2,"Glucose":150,"BloodPressure":72,"SkinThickness":30,"Insulin":120,"BMI":34,"DiabetesPedigreeFunction":0.5,"Age":45}}' >/dev/null
          done
          sleep 35
          curl -fsS localhost:9090/api/v1/targets | python3 -c "import json,sys; t={x['labels']['job']: x['health'] for x in json.load(sys.stdin)['data']['activeTargets']}; print(t); assert t['ihds-api'] == 'up'"
          curl -fsS localhost:9090/api/v1/query --data-urlencode 'query=sum(ihds_predictions_total)' | python3 -c "import json,sys; r=json.load(sys.stdin)['data']['result']; print(r); assert float(r[0]['value'][1]) >= 20"
          curl -fsS localhost:3000/api/health
          curl -fsS localhost:3000/api/datasources/uid/ihds-prometheus/health | grep -q '"status":"OK"'
          curl -fsS 'localhost:3000/api/search?query=IHDS' | grep -q ihds-api
      - if: always()
        run: docker compose -f docker-compose.monitoring.yml logs --no-color | tail -200
      - if: always()
        run: docker compose -f docker-compose.monitoring.yml down -v

  # Optional CD. Runs only when started by hand (Actions -> ci-cd -> Run workflow, deploy = true) AND the
  # repo has these secrets: AZURE_CREDENTIALS (service-principal JSON for azure/login), ACR_NAME,
  # AZURE_RESOURCE_GROUP. Vocareum lab accounts usually cannot create service principals, so this job has
  # not been run; the live Azure app was deployed with deploy/azure/deploy_aca.sh from Cloud Shell.
  deploy:
    needs: docker
    if: github.event_name == 'workflow_dispatch' && inputs.deploy
    runs-on: ubuntu-latest
    environment: azure
    steps:
      - uses: actions/checkout@v4
      - uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}
      - name: Build in ACR and update the Container App
        run: |
          az acr build -r "${{ secrets.ACR_NAME }}" -t ihds:${{ github.sha }} .
          az containerapp update -n ihds-app -g "${{ secrets.AZURE_RESOURCE_GROUP }}" \
            --image "${{ secrets.ACR_NAME }}.azurecr.io/ihds:${{ github.sha }}"
