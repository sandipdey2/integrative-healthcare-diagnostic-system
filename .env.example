# Optional environment variables. Copy to .env (git-ignored) and fill in real values; never commit .env.
# Streamlit Community Cloud uses the [database] / [grafana] / [langsmith] tables in secrets instead.

# Assessment audit log (Neon pooled URL, or any Postgres). Without it the app uses local SQLite (data/audit.db).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ihds?sslmode=require
